# These defaults are intentionally safe for local demo startup only.
POSTGRES_DB=careerflow
POSTGRES_USER=careerflow
POSTGRES_PASSWORD=careerflow-dev-password
DATABASE_URL=postgresql+psycopg://careerflow:careerflow-dev-password@db:5432/careerflow
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Demo mode: shows a banner, disables external write integrations and enables
# `python -m careerflow.demo reset`. Default for the public demo.
DEMO_MODE=true
# Local/self-hosted: one installation, profile selection, no login (see ADR-014).
AUTH_MODE=local

# Structured JSON logs. Comma-separated literal values to always redact (API keys etc.).
LOG_LEVEL=INFO
LOG_REDACT_VALUES=

# AI is optional. With AI_ENABLED=false every non-AI workflow works unchanged.
AI_ENABLED=false
AI_PROVIDER=fixture
AI_MODEL=
AI_ENDPOINT=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
